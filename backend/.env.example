# Environment Configuration Example for CleanAI Backend
NODE_ENV=production
PORT=4000

# Databases
DATABASE_URL=postgresql://user:pass@host:port/db?sslmode=require
REDIS_URL=rediss://default:pass@host:port

# Security & JWT
JWT_SECRET=your_jwt_secret_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters

# External APIs
GEMINI_API_KEY=your_gemini_api_key
CLOUDINARY_URL=cloudinary://key:secret@cloud_name
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional / Feature flags
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RESEND_API_KEY=your_resend_email_api_key

# Cross-Origin Policies
FRONTEND_URL=https://cleanai-frontend.vercel.app
SOCKET_CORS_ORIGIN=https://cleanai-frontend.vercel.app
