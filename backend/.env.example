# ==============================================================================
# CLEAN AI PLATFORM - Backend Configuration Template (.env.example)
# ==============================================================================

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Neon pooled connection (PgBouncer) — for runtime queries
DATABASE_URL=postgresql://user:pass@host:5432/cleanai?schema=public&pgbouncer=true
# Direct connection required for migrations and schema pushes
DIRECT_URL=postgresql://user:pass@host:5432/cleanai?schema=public

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
JWT_SECRET=<your_super_secret_jwt_key_min_32_chars>
JWT_REFRESH_SECRET=<your_super_secret_refresh_key_min_32_chars>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── SERVER & CORS ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_VERSION=v1
CORS_ORIGIN=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app
SOCKET_CORS_ORIGIN=https://your-app.vercel.app

# ─── AI (GEMINI & GROQ DISPATCH ENGINES) ──────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── STORAGE (CLOUDINARY) ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── EMAIL & NOTIFICATIONS ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@criska.ai
RESEND_API_KEY=

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── PAYMENTS (RAZORPAY) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── MAPS ─────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── FCM (PUSH NOTIFICATIONS) ──────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
