# ==============================================================================
# CLEAN AI PLATFORM - Backend Configuration Template (.env.example)
# Copy to .env and fill in. Every variable here is read by src/config/env.ts.
# ==============================================================================

# ─── DATABASE (Supabase Postgres) ─────────────────────────────────────────────
# Pooled connection (PgBouncer, port 6543) — used at runtime by Prisma Client
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (port 5432) — required for `prisma db push` / migrations
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48   (min 32 chars, unique per environment)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── SERVER & CORS ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_VERSION=v1
# Set all three to the deployed frontend origin (no trailing slash)
CORS_ORIGIN=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app
SOCKET_CORS_ORIGIN=https://your-app.vercel.app

# ─── AI (GEMINI & GROQ DISPATCH ENGINES) ──────────────────────────────────────
# At least ONE is required in production (startup is blocked otherwise).
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── STORAGE (CLOUDINARY) ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── EMAIL (SMTP / NODEMAILER — optional, emails skipped while empty) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@cleanai.com

# ─── REDIS (optional — in-memory fallback if unset/unreachable) ───────────────
# On Vercel use a hosted Redis (e.g. Upstash): rediss://default:<pass>@<host>:6379
REDIS_URL=

# ─── PAYMENTS (RAZORPAY — mock mode while empty) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── FCM (PUSH NOTIFICATIONS — optional) ──────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
