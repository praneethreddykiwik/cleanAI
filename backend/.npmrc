# bullmq@5 declares `redis@>=5` as an OPTIONAL peer, but this project pins
# redis@^4 for its own cache client (src/config/redis.ts). The two are used
# independently — bullmq talks to Redis over ioredis — so the conflict is
# cosmetic and npm's strict peer resolution is the only thing that objects.
#
# Without this, `npm install` fails with ERESOLVE on any clean machine,
# including Vercel. CI already passed --legacy-peer-deps by hand; this makes
# local, CI, and deploy installs behave identically.
legacy-peer-deps=true
