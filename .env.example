# ==============================================================================
# CLEAN AI PLATFORM — Configuration Template
# ==============================================================================
# This is ONE Next.js app: the UI and the API (server/, mounted at /api) share
# a single process and a single set of environment variables.
#
#   Local:  cp .env.example .env.local   and fill in the values
#   Vercel: add the same keys under Settings → Environment Variables
#
# Next.js loads .env.local and .env automatically — no dotenv wiring needed.
# Only NEXT_PUBLIC_* values are exposed to the browser; everything else stays
# server-side.
# ==============================================================================

# ─── DATABASE (Supabase Postgres) ─────────────────────────────────────────────
# Pooled connection (PgBouncer, port 6543) — used at runtime by Prisma Client
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (port 5432) — required for `npm run db:push` / migrations
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48   (min 32 chars, unique per environment)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── SERVER ───────────────────────────────────────────────────────────────────
NODE_ENV=development
API_VERSION=v1
# The UI and API share one origin now, so CORS only matters for external
# clients (mobile apps, partner integrations). Set to the production domain.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000

# ─── AI (GEMINI & GROQ DISPATCH ENGINES) ──────────────────────────────────────
# At least ONE is required in production (startup is blocked otherwise).
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── STORAGE (CLOUDINARY) ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── EMAIL (SMTP / NODEMAILER — optional, emails skipped while empty) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@cleanai.com

# ─── REDIS (optional — in-memory fallback if unset/unreachable) ───────────────
# On Vercel use a hosted Redis (e.g. Upstash): rediss://default:<pass>@<host>:6379
REDIS_URL=

# ─── PAYMENTS (RAZORPAY — mock mode while empty) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── FCM (PUSH NOTIFICATIONS — optional) ──────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── BROWSER-EXPOSED VALUES ───────────────────────────────────────────────────
# Leave the API/socket URLs UNSET. The UI calls its own origin (/api/v1)
# automatically — see lib/config.ts. Only set them to target a different host.
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SOCKET_URL=
# NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
