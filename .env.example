# =========================================================================
# Criska CleanAI — Unified Production Configuration Environment Variables
# =========================================================================

# --- Server Core config ---
PORT=4000
NODE_ENV=production
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# --- Neon PostgreSQL Database ---
# Replace with your Neon connection string details
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cleanai?schema=public"

# --- JSON Web Token Authorization Keys ---
JWT_SECRET="generate-a-strong-jwt-secret-key-32-chars"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="generate-a-strong-jwt-refresh-secret-key-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Redis Caching & Queue Broker ---
REDIS_URL="redis://127.0.0.1:6379"

# --- Google Gemini AI & Multi-Agent Keys ---
# Core AI Orchestrator requirement
GEMINI_API_KEY="your-google-gemini-api-key"

# --- Cloudinary Storage bucket config ---
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# --- Razorpay Sandbox & Production Gateway ---
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# --- SMTP Production Email Configs ---
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your-smtp-secret-password"
SMTP_FROM='"Criska CleanAI Support" <support@cleanai.com>'
SMTP_SECURE=false

# --- Firebase Cloud Messaging Push ---
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"
FIREBASE_PRIVATE_KEY="your-firebase-private-key-with-newlines"

# --- Frontend Client telemetry Configs ---
NEXT_PUBLIC_API_URL="https://your-backend.up.railway.app/api/v1"
NEXT_PUBLIC_SOCKET_URL="https://your-backend.up.railway.app"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
