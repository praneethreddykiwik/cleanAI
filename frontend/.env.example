# ==============================================================================
# CLEAN AI PLATFORM - Frontend Configuration Template (.env.example)
# Copy to .env.local for local development.
# ==============================================================================

# ─── API & SOCKETS ────────────────────────────────────────────────────────────
# LOCAL DEV: point at the local backend.
# VERCEL (single project with Services): LEAVE ALL THREE UNSET — the app
# automatically uses the same origin (/api/v1) in production (see lib/config.ts).
# Only set these if the backend is deployed on a separate domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# ─── GOOGLE MAPS ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
